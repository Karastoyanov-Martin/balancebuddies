{
  "name": "balancebuddies-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BalanceBuddies low-fidelity prototype: TFT Set 18 balance investigation, perspective configuration and combat sandbox.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:data": "vitest run tests/zz_dump_data.test.ts && node research/verify.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "2.1.8"
  }
}
